{
  "坐骑战斗加成": {
    "战马": {"formula": {"攻击": "core", "速度": "(L-50)*G"}},
    "乌云踏雪": {"formula": {"气血": "core*5", "攻击": "atkHeavy"}},
    "绝影": {"formula": {"气血": "core*5", "精力": "100+atkHeavy*5"}},
    "里飞沙": {"formula": {"攻击": "atkHeavy", "速度": "L*G"}},
    "夜照玉狮子": {"formula": {"气血": "core*5", "速度": "L*G"}},
    "的卢": {"formula": {"气血": "100+精力Base*5", "精力": "50+core*5"}},
    "爪黄飞电": {"formula": {"精力": "200+(L*0.2+28)*L*G*5"}},
    "燎原火": {"formula": {"攻击": "200+(L*0.2+28)*L*G"}},
    "赤兔胭脂兽": {"formula": {"速度": "(50+L)*G"}},
    "逍遥灰影": {"formula": {"攻击": "core", "抗物理": "10+0.1*L", "抗玄击": "0.05*L"}},
    "天马白鸽": {"formula": {"精力": "core*5", "抗围困": "5+0.1*L", "抗扰乱": "0.05*L", "抗封锁": "0.05*L"}},
    "如山乌孙": {"formula": {"精力": "core*5", "抗围困": "0.05*L", "抗扰乱": "5+0.1*L", "抗封锁": "0.05*L"}},
    "百里惊帆": {"formula": {"精力": "core*5", "抗围困": "0.05*L", "抗扰乱": "0.05*L", "抗封锁": "5+0.1*L"}},
    "嘶啸奔雷": {"formula": {"速度": "L*G", "抗落雷": "5+0.1*L", "抗风沙": "0.05*L", "抗妖火": "0.05*L"}},
    "不死黑云": {"formula": {"气血": "core*5", "抗毒术": "5+0.1*L", "抗风沙": "0.05*L", "抗妖火": "0.05*L"}},
    "南蛮象骑": {"formula": {"气血": "150+(L*0.2+21)*L*G*5", "速度": "(L-50)*G"}},
    "攻城锤": {"formula": {"攻击": "atkHeavy", "穿透率": "0.1*L"}},
    "司南车": {"formula": {"气血": "core*5", "精力": "core*5"}, "stageEffect": {"文人技能成功率": "0.1*L"}},
    "诸葛连弩": {"formula": {"精力": "100+(L*0.2+14)*L*G*5", "速度": "(L-50)*G", "法穿率": "0.1*L"}},
    "木牛流马": {"formula": {"气血": "core*5", "精力": "core*5"}, "stageEffect": {"回合末自动回复": "maxHp*0.001*L"}}
  }
}
